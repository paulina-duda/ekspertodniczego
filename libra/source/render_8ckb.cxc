# 8CKB — asymmetric reconstruction of the crAss001 virion.
# Run from the repository root:
#   chimerax --offscreen libra/source/render_8ckb.cxc

open ../data/cif/8ckb.cif logInfo false
view
hide #1 target ab
cartoon #1
show #1 target c

# One batched operation keeps the 1,445-chain render memory-efficient while
# making neighbouring protein copies and the asymmetric tail easy to follow.
color #1 bychain target c

lighting soft
graphics bgColor #05070c
graphics silhouettes true color #111827 width 0.8
graphics quality 0.5
turn y 22
turn x -12
zoom 1.13
save ../renders/png/8ckb_virion-cartoon.png width 1200 height 1200 supersample 1
exit
